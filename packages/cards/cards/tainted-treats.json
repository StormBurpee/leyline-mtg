{
  "$schema": "../schema/card.schema.json",
  "schemaVersion": 1,
  "id": "60826714-b9fd-4c89-b9f2-1a3c3229686b",
  "name": "Tainted Treats",
  "characteristics": {
    "types": ["instant"],
    "supertypes": [],
    "subtypes": [],
    "colors": ["B", "G"],
    "manaCost": "{1}{B}{G}"
  },
  "rulesText": "Destroy target artifact or creature. If its mana value was 4 or less, create a Food token. (It's an artifact with \"{2}, {T}, Sacrifice this token: You gain 3 life.\")",
  "abilities": [
    {
      "kind": "spell",
      "target": {
        "scope": "permanent",
        "where": {
          "any": [
            {
              "type": "artifact"
            },
            {
              "type": "creature"
            }
          ]
        }
      },
      "effects": [
        {
          "op": "conditional",
          "condition": {
            "kind": "targetMatches",
            "target": "target",
            "where": {
              "manaValue": {
                "lte": 4
              }
            }
          },
          "then": [
            {
              "op": "destroy",
              "target": "target"
            },
            {
              "op": "createToken",
              "token": "leyline:token/food-token",
              "amount": 1
            }
          ],
          "else": [
            {
              "op": "destroy",
              "target": "target"
            }
          ]
        }
      ]
    }
  ]
}

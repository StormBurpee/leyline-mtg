      "on": {
        "event": "enter",
        "object": "source"
      },
      "effects": [
        {
          "op": "tap",
          "target": "target"
        },
        {
          "op": "addStunCounters",
          "target": "target",
          "amount": 1
        }
      ],
      "target": {
        "scope": "permanent",
        "where": {
          "all": [
            {
              "type": "creature"
            },
            {
              "controller": "opponent"
            }
          ]
        }
      }
    },
    {
      "kind": "triggered",
      "on": {
        "event": "cast",
        "controller": "you",
        "filter": {
          "any": [

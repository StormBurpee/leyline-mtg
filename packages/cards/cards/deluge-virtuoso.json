              "type": "instant"
            },
            {
              "type": "sorcery"
            }
          ]
        }
      },
      "effects": [
        {
          "op": "conditional",
          "condition": {
            "kind": "eventManaSpentAtLeast",
            "count": 5
          },
          "then": [
            {
              "op": "modify",
              "target": "source",
              "power": 2,
              "toughness": 2,
              "until": "endOfTurn"
            }
          ],
          "else": [
            {
              "op": "modify",

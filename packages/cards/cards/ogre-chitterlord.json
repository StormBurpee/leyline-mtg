      "on": {
        "event": "attack",
        "object": "source"
      },
      "effects": [
        {
          "op": "createToken",
          "token": "leyline:token/nonblocking-rat-token",
          "amount": 2
        },
        {
          "op": "conditional",
          "condition": {
            "kind": "controlAtLeast",
            "count": 5,

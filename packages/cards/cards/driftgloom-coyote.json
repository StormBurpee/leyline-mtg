            "target": "target",
            "where": {
              "power": {
                "lte": 2
              }
            }
          },
          "then": [
            {
              "op": "exileUntilSourceLeaves",
              "target": "target"
            },
            {
              "op": "addCounters",
              "target": "source",
              "counter": "+1/+1",

{
  "$schema": "../schema/card.schema.json",
  "schemaVersion": 1,
  "id": "91363d71-eef0-48e8-9a68-8f363ff2790e",
  "name": "Tend the Sprigs",
  "characteristics": {
    "types": ["sorcery"],
    "supertypes": [],
    "subtypes": [],
    "colors": ["G"],
    "manaCost": "{2}{G}"
  },
  "rulesText": "Search your library for a basic land card, put it onto the battlefield tapped, then shuffle. Then if you control seven or more lands and/or Treefolk, create a 3/4 green Treefolk creature token with reach. (It can block creatures with flying.)",
  "abilities": [
    {
      "kind": "spell",
      "effects": [
        {
          "op": "searchLibrary",
          "amount": 1,
          "destination": "battlefield",
          "where": {
            "all": [
              {
                "type": "land"
              },
              {
                "basic": true
              }
            ]
          },
          "tapped": true
        },
        {
          "op": "conditional",
          "condition": {
            "kind": "controlAtLeast",
            "count": 7,
            "where": {
              "any": [
                {
                  "type": "land"
                },
                {
                  "subtype": "Treefolk"
                }
              ]
            }
          },
          "then": [
            {
              "op": "createToken",
              "token": "leyline:token/reach-treefolk-token",
              "amount": 1
            }
          ]
        }
      ]
    }
  ]
}

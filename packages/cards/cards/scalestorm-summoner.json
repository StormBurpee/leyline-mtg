{
  "$schema": "../schema/card.schema.json",
  "schemaVersion": 1,
  "id": "55ede1d4-593d-433c-943a-4db12eeb5fa8",
  "name": "Scalestorm Summoner",
  "characteristics": {
    "types": ["creature"],
    "supertypes": [],
    "subtypes": ["Human", "Warlock"],
    "colors": ["R"],
    "manaCost": "{2}{R}",
    "power": 3,
    "toughness": 3
  },
  "rulesText": "Whenever this creature attacks, create a 3/1 red Dinosaur creature token if you control a creature with power 4 or greater.",
  "abilities": [
    {
      "kind": "triggered",
      "on": {
        "event": "attack",
        "object": "source"
      },
      "effects": [
        {
          "op": "conditional",
          "condition": {
            "kind": "controlAtLeast",
            "where": {
              "all": [
                {
                  "power": {
                    "gte": 4
                  }
                },
                {
                  "type": "creature"
                }
              ]
            },
            "count": 1
          },
          "then": [
            {
              "op": "createToken",
              "token": "leyline:token/dinosaur-token",
              "amount": 1
            }
          ]
        }
      ]
    }
  ]
}

{
  "$schema": "../schema/card.schema.json",
  "schemaVersion": 1,
  "id": "87f82d15-5b6b-400f-8a15-d45a2a735f7d",
  "name": "Experimental Confectioner",
  "characteristics": {
    "types": ["creature"],
    "supertypes": [],
    "subtypes": ["Human", "Peasant"],
    "colors": ["B"],
    "manaCost": "{2}{B}",
    "power": 2,
    "toughness": 3
  },
  "rulesText": "When this creature enters, create a Food token. (It's an artifact with \"{2}, {T}, Sacrifice this token: You gain 3 life.\")\nWhenever you sacrifice a Food, create a 1/1 black Rat creature token with \"This token can't block.\"",
  "abilities": [
    {
      "kind": "triggered",
      "on": {
        "event": "enter",
        "object": "source"
      },
      "effects": [
        {
          "op": "createToken",
          "token": "leyline:token/food-token",
          "amount": 1
        }
      ]
    },
    {
      "kind": "triggered",
      "on": {
        "event": "sacrifice",
        "controller": "you",
        "filter": {
          "subtype": "Food"
        }
      },
      "effects": [
        {
          "op": "createToken",
          "token": "leyline:token/nonblocking-rat-token",
          "amount": 1
        }
      ]
    }
  ]
}

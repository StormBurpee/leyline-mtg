    },
    {
      "kind": "triggered",
      "on": {
        "event": "cast",
        "controller": "you",
        "filter": {
          "not": {
            "type": "creature"
          }
        }
      },
      "effects": [
        {
          "op": "addCounters",
          "target": "target",
          "counter": "+1/+1",
          "amount": 3
        }
      ],
      "target": {
        "scope": "permanent",
        "where": {
          "all": [
            {
              "controller": "you"
            },
            {
              "type": "creature"
            }
          ]
        }
      }
    },
    {
      "kind": "triggered",
      "on": {
        "event": "enter",
        "controller": "you",
        "filter": {
          "type": "land"
        }
      },
      "effects": [
        {
          "op": "gainLife",
          "target": "controller",
          "amount": 3
        }

{
  "$schema": "../schema/card.schema.json",
  "schemaVersion": 1,
  "id": "f633c16d-d943-421c-ad18-af35db9ec9fc",
  "name": "Primeval Bounty",
  "characteristics": {
    "types": ["enchantment"],
    "supertypes": [],
    "subtypes": [],
    "colors": ["G"],
    "manaCost": "{5}{G}"
  },
  "rulesText": "Whenever you cast a creature spell, create a 3/3 green Beast creature token.\nWhenever you cast a noncreature spell, put three +1/+1 counters on target creature you control.\nLandfall — Whenever a land you control enters, you gain 3 life.",
  "abilities": [
    {
      "kind": "triggered",
      "on": {
        "event": "cast",
        "controller": "you",
        "filter": {
          "type": "creature"
        }
      },
      "effects": [
        {
          "op": "createToken",
          "token": "leyline:token/beast-token",
          "amount": 1
        }

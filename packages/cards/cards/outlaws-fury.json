                    },
                    {
                      "subtype": "Warlock"
                    }
                  ]
                }
              ]
            }
          },
          "then": [
            {
              "op": "exileTop",
              "count": 1,
              "player": "controller",
              "duration": "nextTurn"
            }
          ]
        }
      ]

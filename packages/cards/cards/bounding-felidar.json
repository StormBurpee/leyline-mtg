    {
      "kind": "triggered",
      "on": {
        "event": "attack",
        "object": "source"
      },
      "triggerCondition": {
        "kind": "sourceSaddled"
      },
      "effects": [
        {
          "op": "counterAll",
          "where": {
            "all": [
              {
                "type": "creature"
              },
              {
                "controller": "you"
              }
            ]
          },
          "excludeSource": true,
          "amount": 1
        },
        {
          "op": "gainLife",
          "target": "controller",
          "amount": {
            "kind": "count",
            "zone": "battlefield",
            "player": "you",
            "where": {
              "type": "creature"
            },
            "excludeSource": true
          }
        }
      ]
    },
    {
      "kind": "saddle",
      "power": 2
    }
  ]
}

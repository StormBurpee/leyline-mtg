  "rulesText": "Destroy target artifact or enchantment. If its mana value was 2 or less, create a Lander token. (It's an artifact with \"{2}, {T}, Sacrifice this token: Search your library for a basic land card, put it onto the battlefield tapped, then shuffle.\")",
  "abilities": [
    {
      "kind": "spell",
      "target": {
        "scope": "permanent",
        "where": {
          "any": [
            {
              "type": "artifact"
            },
            {
              "type": "enchantment"
            }
          ]
        }
      },
      "effects": [
        {
          "op": "conditional",
          "condition": {
            "kind": "targetMatches",
            "target": "target",
            "where": {
              "manaValue": {
                "lte": 2
              }
            }
          },
          "then": [
            {
              "op": "destroy",
              "target": "target"
            },
            {
              "op": "createToken",
              "token": "leyline:token/lander-token",
              "amount": 1
            }
          ],
          "else": [
            {
              "op": "destroy",
              "target": "target"
            }
          ]
        }
      ]
    }
  ]
}

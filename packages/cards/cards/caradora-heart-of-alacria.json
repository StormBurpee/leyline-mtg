              {
                "subtype": "Vehicle"
              }
            ]
          },
          "destination": "hand",
          "amount": 1,
          "reveal": true
        }
      ]
    },
    {
      "kind": "plusCounterBonus",
      "amount": 1,
      "scope": "creatureOrVehicleYouControl"
    }
  ]

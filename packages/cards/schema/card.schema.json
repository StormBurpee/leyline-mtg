{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leyline:card:1",
  "title": "Leyline card source v1",
  "description": "Versioned declarative card data. Structural validity does not imply that every requested mechanic is implemented; compilation is the capability gate.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[a-z][a-z0-9.-]*:[A-Za-z0-9_/-]+)$",
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "characteristics": {
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "enum": ["land", "creature", "instant", "sorcery", "artifact", "enchantment"]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "subtypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "colors": {
          "type": "array",
          "items": {
            "enum": ["W", "U", "B", "R", "G"]
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        },
        "manaCost": {
          "anyOf": [
            {
              "$ref": "#/$defs/mana"
            },
            {
              "type": "null"
            }
          ]
        },
        "power": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "toughness": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "token": {
          "type": "boolean"
        },
        "supertypes": {
          "type": "array",
          "items": {
            "enum": ["basic", "legendary", "snow", "world"]
          },
          "uniqueItems": true,
          "maxItems": 4
        }
      },
      "required": ["types", "manaCost"],
      "additionalProperties": false
    },
    "rulesText": {
      "type": "string",
      "maxLength": 20000
    },
    "abilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ability"
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": ["schemaVersion", "id", "name", "characteristics", "abilities"],
  "additionalProperties": false,
  "$defs": {
    "comparison": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "eq": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["eq"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ne": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["ne"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lt": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["lt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lte": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["lte"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gt": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["gt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gte": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["gte"],
          "additionalProperties": false
        }
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": ["all"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": ["any"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/predicate"
            }
          },
          "required": ["not"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["land", "creature", "instant", "sorcery", "artifact", "enchantment"]
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "color": {
              "enum": ["W", "U", "B", "R", "G", "colorless"]
            }
          },
          "required": ["color"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "controller": {
              "enum": ["you", "opponent"]
            }
          },
          "required": ["controller"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "owner": {
              "enum": ["you", "opponent"]
            }
          },
          "required": ["owner"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tapped": {
              "type": "boolean"
            }
          },
          "required": ["tapped"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "token": {
              "type": "boolean"
            }
          },
          "required": ["token"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "power": {
              "$ref": "#/$defs/comparison"
            }
          },
          "required": ["power"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "toughness": {
              "$ref": "#/$defs/comparison"
            }
          },
          "required": ["toughness"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "manaValue": {
              "$ref": "#/$defs/comparison"
            }
          },
          "required": ["manaValue"],
          "additionalProperties": false
        },
        {
          "type": "object",

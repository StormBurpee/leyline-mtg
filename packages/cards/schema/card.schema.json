            },
            "amount": {
              "$ref": "#/$defs/numericValue"
            }
          },
          "required": ["op", "target", "amount"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "surveil"
            },

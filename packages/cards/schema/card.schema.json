            }
          },
          "required": ["basic"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "subtype": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": ["subtype"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "legendary": {
              "type": "boolean"
            }
          },
          "required": ["legendary"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "attacking": {
              "type": "boolean"
            }
          },
          "required": ["attacking"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "blocking": {
              "type": "boolean"
            }
          },
          "required": ["blocking"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "keyword": {
              "enum": [
                "flying",
                "reach",
                "haste",
                "vigilance",
                "trample",
                "deathtouch",
                "lifelink",
                "defender",
                "first strike",
                "double strike",
                "flash",
                "hexproof",
                "shroud",
                "indestructible",
                "menace"
              ]
            }
          },
          "required": ["keyword"],
          "additionalProperties": false
        }
      ]
    },
    "selector": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "permanent",
            "spell",
            "player",
            "damageable",
            "graveyard",
